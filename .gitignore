# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/

# Virtualenvs
.venv/
venv/
env/

# Secrets & generated material (NEVER commit)
*.key
*.pem
*.p12
*.pfx
!**/ca/.gitkeep
security/certs/**
!security/certs/.gitkeep
security/keys/**
*.crt
!docs/**/*.crt

# Local env files (secrets); keep the .example templates tracked
.env
deploy/.env

# Runtime data
*.db
*.db-journal
*.sqlite
*.sqlite3
data/
logs/
server/*.db
received/
downloads/
*.log
*.jsonl

# Client local storage (encrypted, but machine-specific)
client_storage/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Benchmark outputs
benchmarks/out/
results/*.csv
charts/*.png
# ...but the committed report charts under docs/charts/ are evidence
!docs/charts/
!docs/charts/*.png
