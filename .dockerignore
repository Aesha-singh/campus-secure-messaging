# Build context exclusions for the CSCP server image.
.git
.gitignore
.github
**/__pycache__
**/*.py[cod]
.venv
venv
env
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
data
logs
captures
docs
tests
*.md
!README.md
.env
# Never bake locally-generated secrets into the image (the PKI is created at
# runtime inside the mounted volume; user DBs are provisioned on first boot).
security/certs/*.pem
security/certs/*.key
security/certs/*.crt
security/users.yaml
