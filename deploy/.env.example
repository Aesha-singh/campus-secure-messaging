# Secrets for the local docker-compose stack.  Copy to `.env` and replace every
# value -- generate fresh ones with:
#     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# CSCP_SERVER_SECRET signs/derives auth tokens; rotating it invalidates all
# outstanding session-resume tokens (clients simply re-authenticate).
CSCP_SERVER_SECRET=change-me-32-plus-random-bytes-please
# Password for the admin console (currently reserved; the dashboard uses the
# bearer token below for /metrics and /).
CSCP_ADMIN_PASSWORD=change-me-admin-console-password
# Bearer token required by GET /metrics and the dashboard HTML.
CSCP_ADMIN_TOKEN=change-me-admin-bearer-token
# Password the entrypoint assigns to the demo accounts (alice, bob) on first
# boot.  Demo only -- change it or supply your own users.yaml for real use.
# Must satisfy the policy: >=8 chars with at least one letter and one digit.
CSCP_DEMO_PASSWORD=campus-demo1
